# Copy to .env — TMDB_API_KEY is the only required value.
PORT=3000
DATA_DIR=./data
TZ=Europe/Paris

# TMDB v3 API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# true when nginx/caddy/traefik sits in front (needed for secure cookies + real client IPs)
TRUST_PROXY=true

# Let visitors create accounts. The first account ever created is always allowed and becomes admin.
ALLOW_REGISTRATION=true

# Sessions expire after this many days of inactivity.
SESSION_DAYS=90

# Background refresh: how often the scheduler ticks and how many titles it may sync per tick.
REFRESH_INTERVAL_MINUTES=360
REFRESH_BATCH=40

# One-shot migration from the old WatchRadar (v1) database. When set and the new database
# is still empty, the server imports everything from this file on first boot.
# LEGACY_DB=/data/legacy/watchradar.sqlite3
