{
  "name": "watchradar",
  "version": "2.0.0",
  "private": true,
  "description": "WatchRadar \u2014 track the movies and series you watch, keep an eye on what's next.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "check": "svelte-check --tsconfig ./client/tsconfig.json",
    "test": "node --test server/test/*.test.js",
    "migrate:legacy": "node --env-file-if-exists=.env server/scripts/migrate-legacy.js",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.9.1",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "concurrently": "^9.1.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
